@model List<Feature>
@{
    ViewData["Title"] = "FeatureList";
    Layout = "~/Views/Layout/Index.cshtml";
}

<div class="main-panel">
    <div class="content">
        <div class="container-fluid">
            <h4 class="page-title">Feature</h4>
            <div class="row">
                <div class="col-md-12">
                    <div class="card">
                        <div class="card-header">
                            <div class="card-title">Feature List</div>
                        </div>
                        <div class="card-body">
                            <div class="card-sub">
                                You can perform Feature-related operations below.:
                            </div>
                            <table class="table mt-3">
                                <thead>
                                    <tr>
                                        <th scope="col">ID</th>
                                        <th scope="col">Title</th>
                                        <th scope="col">Description</th>
                                        <th scope="col">Delete</th>
                                        <th scope="col">Update</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td>@item.FeatureId</td>
                                            <td>@item.Title</td>
                                            <td>@item.Description</td>

                                            <td> <a class="btn btn-danger" href="/Feature/FeatureDelete/@item.FeatureId">Delete</a> </td>
                                            <td> <a class="btn btn-success" href="/Feature/FeatureUpdate/@item.FeatureId">Update</a> </td>
                                        </tr>
                                    }


                                </tbody>
                            </table>
                            <a href="/Feature/FeatureCreate" class="btn btn-info">Feature Add</a>
                        </div>
                    </div>

                </div>

            </div>
        </div>
    </div>

</div>