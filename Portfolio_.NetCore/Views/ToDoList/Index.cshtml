@model List<ToDoList>
@{
	ViewData["Title"] = "ToDoList";
	Layout = "~/Views/Layout/Index.cshtml";
	int count = 0;
}


<div class="main-panel">
	<div class="content">
		<div class="container-fluid">
			<h4 class="page-title">ToDoList</h4>
			<div class="row">
				<div class="col-md-12">
					<div class="card">
						<div class="card-header">
							<div class="card-title">ToDoList List</div>
						</div>
						<div class="card-body">
							<div class="card-sub">
								You can perform ToDoList-related operations below.:
							</div>
							<table class="table mt-3">
								<thead>
									<tr>
										<th scope="col">ID</th>
										<th scope="col">Title</th>
										<th scope="col">Date</th>
										<th scope="col">Status</th>
										<th scope="col">Delete</th>
										<th scope="col">Update</th>
									</tr>
								</thead>
								<tbody>
									@foreach (var item in Model)
									{
										count++;
										<tr>
											<td>@count</td>
											<td>@item.Title</td>
											<td>@item.Date</td>
											@if (item.Status == true)
											{
												<td> <a class="btn btn-dark" href="/ToDoList/ToDoListStatusFalse/@item.ToDoListId">To Do</a> </td>

											}
											else
											{
												<td> <div><a class="btn btn-warning" href="/ToDoList/ToDoListStatusTrue/@item.ToDoListId">Not To Do</a></div> </td>

											}
											<td> <a class="btn btn-danger" href="/ToDoList/DeleteToDoList/@item.ToDoListId">Delete</a> </td>
											<td> <a class="btn btn-success" href="/ToDoList/UpdateToDoList/@item.ToDoListId">Update</a> </td>
										</tr>
									}


								</tbody>
							</table>
							<a href="/ToDoList/CreateToDoList" class="btn btn-info">ToDoList Add</a>
						</div>
					</div>

				</div>

			</div>
		</div>
	</div>

</div>