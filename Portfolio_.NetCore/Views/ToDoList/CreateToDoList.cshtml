@model ToDoList
@{
    ViewData["Title"] = "CreateToDoList";
    Layout = "~/Views/Layout/Index.cshtml";
}


<div class="main-panel">
    <div class="content">
        <div class="container-fluid">
            <h4 class="page-title">ToDoList</h4>
            <div class="row">
                <div class="col-md-12">
                    <div class="card">
                        <div class="card-header">
                            <div class="card-title">ToDoList List</div>
                        </div>
                        <div class="card-body">

                            <form method="post">

                                <label>ToDoList Title</label>
                                <input type="text" asp-for="Title" class="form-control" />
                                <br />
                                <label>ToDoList Date</label>
                                <input type="date" asp-for="Date" class="form-control" />
                                <br />
                                <label>Image Url</label>
                                <input type="text" asp-for="ImageUrl" class="form-control" />
                                <br />
                           
                                <button class="btn btn-primary"> ToDoList Add</button>
                            </form>


                        </div>
                    </div>

                </div>

            </div>
        </div>
    </div>
</div>



