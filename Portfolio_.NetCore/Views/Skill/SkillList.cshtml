@model List<Skill>
@{
    ViewData["Title"] = "SkillList";
    Layout = "~/Views/Layout/Index.cshtml";
}

<div class="main-panel">
    <div class="content">
        <div class="container-fluid">
            <h4 class="page-title">Skill</h4>
            <div class="row">
                <div class="col-md-12">
                    <div class="card">
                        <div class="card-header">
                            <div class="card-title">Skill List</div>
                        </div>
                        <div class="card-body">
                            <div class="card-sub">
                                You can perform Skill-related operations below:
                            </div>

                            <!-- Scrollable tablo kapsayıcısı -->
                            <div class="table-responsive">
                                <table class="table mt-3 table-bordered table-striped align-middle">
                                    <thead class="table-light">
                                        <tr>
                                            <th>ID</th>
                                            <th>Title</th>
                                            <th>Value</th>
                                           
                                            <th>Delete</th>
                                            <th>Update</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model)
                                        {
                                            <tr>
                                                <td>@item.SkillId</td>
                                                <td>@item.Title</td>
                                                <td>@item.Value</td>
                                           
                                                <td>
                                                    <a class="btn btn-danger btn-sm" href="/Skill/SkillDelete/@item.SkillId">Delete</a>
                                                </td>
                                                <td>
                                                    <a class="btn btn-success btn-sm" href="/Skill/SkillUpdate/@item.SkillId">Update</a>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                            <a href="/Skill/SkillCreate" class="btn btn-info mt-3">Add New Skill</a>
                        </div>

                    </div>

                </div>

            </div>
        </div>
    </div>

</div>