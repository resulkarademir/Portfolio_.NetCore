@model Contact
@{
    ViewData["Title"] = "ContactCreate";
    Layout = "~/Views/Layout/Index.cshtml";
}
<div class="main-panel">
    <div class="content">
        <div class="container-fluid">
            <h4 class="page-title">Contact</h4>
            <div class="row">
                <div class="col-md-12">
                    <div class="card">
                        <div class="card-header">
                            <div class="card-title">Contact List</div>
                        </div>
                        <div class="card-body">

                            <form method="post">

                                <label>Contact Title</label>
                                <input type="text" asp-for="Title" class="form-control" />
                                <br />
                                <label>Contact Description</label>
                                <input type="text" asp-for="Description" class="form-control" />
                                <br />
                                <label>Contact Phone1</label>
                                <input type="text" asp-for="Phone1" class="form-control" />
                                <br />
                                <label>Contact Phone2</label>
                                <input type="text" asp-for="Phone2" class="form-control" />
                                <br />
                                <label>Contact Email1</label>
                                <input type="text" asp-for="Email1" class="form-control" />
                                <br />
                                <label>Contact Email2</label>
                                <input type="text" asp-for="Email2" class="form-control" />
                                <br />
                                <label>Contact Address</label>
                                <input type="text" asp-for="Address" class="form-control" />
                                <br />

                                <button class="btn btn-primary"> Contact Add</button>
                            </form>


                        </div>
                    </div>

                </div>

            </div>
        </div>
    </div>
</div>

