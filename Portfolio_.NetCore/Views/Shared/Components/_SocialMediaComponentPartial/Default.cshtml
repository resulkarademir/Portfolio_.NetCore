@model List<Portfolio_.NetCore.DAL.Entities.SocialMedia>

<ul class="footer-social">

    @foreach (var item in Model)
    {
        var fullUrl = item.Url.StartsWith("http") ? item.Url : "https://" + item.Url;

        <li>
            <a href="@fullUrl" target="_blank" rel="noopener noreferrer">
                <i class="im im-@item.Icon" aria-hidden="true"></i>
                <span>@item.Title</span>
            </a>
        </li>
    }


</ul>