@model List<Portfolio_.NetCore.DAL.Entities.Portfolio>
<section id="works" class="s-works target-section">

    <div class="row narrow section-intro has-bottom-sep">

        @foreach (var item in Model)
        {
            <div class="col-full">
                <h3>@item.HomeTitle</h3>
                <h1>@item.HomeSubTitle</h1>

                <p class="lead">@item.HomeDescription</p>
            </div>
            
        }
     

    </div>

    <div class="row masonry-wrap">
        <div class="masonry">

            @foreach (var item in Model)
            {
                <div class="masonry__brick">
                    <div class="item-folio">

                        <div class="item-folio__thumb">
                            <a href="@item.BigImageUrl" class="thumb-link" title="The Beetle Car" data-size="1050x700">
                                <img src="@item.SmallImageUrl"
                                     srcset="@item.SmallImageUrl 1x, @item.ImageUrl 2x" alt="">
                                <span class="shadow-overlay"></span>
                            </a>
                        </div>

                        <div class="item-folio__text">
                            <h3 class="item-folio__title">
                                @item.Title
                            </h3>
                            <p class="item-folio__cat">
                                @item.SubTitle
                            </p>
                        </div>

                        <a href="https://www.behance.net/" class="item-folio__project-link" title="Project link">
                            <i class="im im-link"></i>
                        </a>

                        <div class="item-folio__caption">
                            <p>@item.Description</p>
                        </div>

                    </div> <!-- end item-folio -->
                </div> <!-- end masonry__brick -->
            }



        </div>
    </div> <!-- end masonry -->

</section> <!-- end works -->
